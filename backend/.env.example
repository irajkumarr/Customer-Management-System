# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/customer_management_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Initial Admin User Setup
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456

# Server & Cookie (Production: same-site=none and secure=true for cross-origin Firebase <-> Render cookies)
PORT=8080
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=timalsinarajkumar.com.np

# CORS (Include your custom domain and Firebase Hosting URL in production)
CORS_ALLOWED_ORIGINS=https://app.timalsinarajkumar.com.np,https://customer-management-ce413.web.app,http://localhost:3000,http://localhost:8080

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Mailgun
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here.com
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=support@your_mailgun_domain_here.com
MAILGUN_WEBHOOK_SIGNING_KEY=your_mailgun_webhook_signing_key_here
