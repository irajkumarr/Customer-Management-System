# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/customer_management_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Initial Admin User Setup
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://localhost:5000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-pro

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=support@yourdomain.com
SENDGRID_WEBHOOK_PUBLIC_KEY=your_sendgrid_webhook_verification_ecdsa_public_key
